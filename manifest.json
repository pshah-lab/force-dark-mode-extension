{
  "manifest_version": 3,
  "name": "Force Dark Mode - ThemeSwitcher",
  "version": "2.2.0",
  "description": "Apply smart dark mode to websites, PDFs, and documents with Auto, CSS, Invert, native dark detection, and local PDF rendering.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "activeTab", "contextMenus", "sidePanel"],
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "commands": {
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Toggle Force Dark Mode on the current site"
    },
    "open-file-viewer": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "Alt+Shift+O"
      },
      "description": "Open the dark document viewer"
    },
    "open-current-document-in-viewer": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Open the current tab's PDF in the dark viewer"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/colorUtils.js",
        "src/shared/themeCore.js",
        "src/shared/builtinThemes.js",
        "src/shared/sitePacks.js",
        "src/shared/customCss.js",
        "src/content/themeEngine/cssOverrideEngine.js",
        "src/content/themeEngine/invertEngine.js",
        "src/content/index.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {},
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none';"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
